{
  "name": "@raggle-ai/amp-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Initialize Raggle projects inside Amp (ampcode.com) from the Raggle project catalog",
  "license": "MIT",
  "author": "Raggle AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/amp-adapter.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "amp-project-init": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dry-run": "npm run build && node dist/main.js"
  },
  "dependencies": {
    "@raggle-ai/local": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
